# justinas.space on Apache. Upload this file together with the rest of dist/.

# Send every http:// request to https:// (permanent redirect).
# The X-Forwarded-Proto check keeps it from looping on hosts that terminate HTTPS in front of Apache.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

ErrorDocument 404 /404.html
DirectoryIndex index.html
Options -Indexes

AddType text/javascript .js .mjs
AddType font/woff2 .woff2
AddType image/svg+xml .svg

# Files in /assets/ have a content hash in their name, so they can be cached for a year.
# HTML is always revalidated, so a new upload shows up immediately.
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript image/svg+xml application/json
</IfModule>
